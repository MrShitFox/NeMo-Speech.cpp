@PACKAGE_INIT@

set(NeMoSpeech_Diarization_FOUND FALSE)
find_library(_nemo_speech_diar_library
    NAMES nemo_speech_diar_c
    PATHS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@"
          "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@"
    NO_DEFAULT_PATH)
if(_nemo_speech_diar_library)
    add_library(NeMoSpeech::Diarization UNKNOWN IMPORTED)
    set_target_properties(NeMoSpeech::Diarization PROPERTIES
        IMPORTED_LOCATION "${_nemo_speech_diar_library}"
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
    set(NeMoSpeech_Diarization_FOUND TRUE)
endif()

check_required_components(NeMoSpeech)
