{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-diar",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "GGML_LLAMAFILE": "ON"
      }
    },
    {
      "name": "cpu-diar",
      "inherits": "base-diar",
      "displayName": "CPU Nemotron 3 diarization",
      "cacheVariables": {
        "NEMO_SPEECH_GGML_PATCHED": "ON"
      }
    },
    {
      "name": "cuda-diar",
      "inherits": "base-diar",
      "displayName": "CUDA Nemotron 3 diarization",
      "cacheVariables": {
        "GGML_CUDA": "ON",
        "NEMO_SPEECH_GGML_PATCHED": "ON"
      }
    },
    {
      "name": "vulkan-diar",
      "inherits": "base-diar",
      "displayName": "Vulkan Nemotron 3 diarization",
      "cacheVariables": {
        "GGML_VULKAN": "ON",
        "NEMO_SPEECH_GGML_PATCHED": "OFF"
      }
    },
    {
      "name": "metal-diar",
      "inherits": "base-diar",
      "displayName": "Metal Nemotron 3 diarization",
      "cacheVariables": {
        "GGML_METAL": "ON",
        "NEMO_SPEECH_GGML_PATCHED": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "cpu-diar", "configurePreset": "cpu-diar" },
    { "name": "cuda-diar", "configurePreset": "cuda-diar" },
    { "name": "vulkan-diar", "configurePreset": "vulkan-diar" },
    { "name": "metal-diar", "configurePreset": "metal-diar" }
  ]
}
